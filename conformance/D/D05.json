{
  "id": "D05",
  "title": "A ceiling takes the lowest value among the grants of the asked action, and a key never goes above its owner.",
  "role": "pdp",
  "paragraphs": [
    "7.3",
    "8.1",
    "8.4"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json"
  },
  "steps": [
    {
      "name": "Alice reads the table orders of test2",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "table",
            "id": "orders",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                },
                {
                  "type": "database",
                  "id": "test2"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_rows": {
            "equals": 100
          },
          "/context/limits/max_duration": {
            "equals": 30
          },
          "/context/usage/units": {
            "equals": 1
          }
        }
      }
    },
    {
      "name": "A value of data.write does not apply to data.read, and the reverse",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "test2",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_duration": {
            "equals": 10
          },
          "/context/limits/max_rows": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "The value 10000 of the key is above the value 5000 of Alice",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:9b1c04e2aa71f0c3"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test2",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_rows": {
            "equals": 5000
          },
          "/context/limits/max_duration": {
            "equals": 30
          }
        }
      }
    }
  ]
}

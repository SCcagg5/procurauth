{
  "id": "E16",
  "title": "An edge that keeps an identity token gives it again for the same subject and the same service only.",
  "role": "edge",
  "paragraphs": [
    "9.9"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_token_cache"
  ],
  "given": {},
  "steps": [
    {
      "name": "Request 1 with the same valid key",
      "request": {
        "method": "GET",
        "path": "/probe",
        "headers": {
          "Authorization": "Bearer {{valid_key_text}}"
        }
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "upstream": {
          "count": {
            "equals": 1
          },
          "token_claims": {
            "/sub": {
              "equals": "{{valid_key_subject}}"
            },
            "/owner": {
              "equals": "{{valid_key_owner}}"
            },
            "/aud": {
              "one_of": [
                "{{service}}",
                [
                  "{{service}}"
                ]
              ]
            }
          }
        }
      }
    },
    {
      "name": "Request 2 with the same valid key",
      "request": {
        "method": "GET",
        "path": "/probe",
        "headers": {
          "Authorization": "Bearer {{valid_key_text}}"
        }
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "upstream": {
          "count": {
            "equals": 1
          },
          "token_claims": {
            "/sub": {
              "equals": "{{valid_key_subject}}"
            },
            "/owner": {
              "equals": "{{valid_key_owner}}"
            },
            "/aud": {
              "one_of": [
                "{{service}}",
                [
                  "{{service}}"
                ]
              ]
            }
          }
        }
      }
    }
  ]
}

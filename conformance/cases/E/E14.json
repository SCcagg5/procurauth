{
  "id": "E14",
  "title": "The identity token never holds the text of the key.",
  "role": "edge",
  "paragraphs": [
    "9.3"
  ],
  "requirement": "MUST",
  "given": {},
  "steps": [
    {
      "name": "A request with a valid key",
      "request": {
        "method": "GET",
        "path": "/probe",
        "headers": {
          "Authorization": "Bearer {{valid_key_text}}"
        }
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "upstream": {
          "count": {
            "equals": 1
          },
          "token_claims": {
            "/sub": {
              "not_regex": "{{valid_key_text}}"
            },
            "/owner": {
              "not_regex": "{{valid_key_text}}"
            },
            "/iss": {
              "not_regex": "{{valid_key_text}}"
            },
            "/aud": {
              "not_regex": "{{valid_key_text}}"
            }
          },
          "token_header": {
            "": {
              "not_regex": "{{valid_key_text}}"
            }
          }
        }
      }
    }
  ]
}

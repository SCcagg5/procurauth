{
  "id": "E18",
  "title": "An edge sends an MCP request with a valid key to the service, for each method of HTTP, and it answers no MCP method itself.",
  "role": "edge",
  "paragraphs": [
    "mcp:6.2"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {},
  "steps": [
    {
      "name": "A JSON-RPC request",
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28",
          "Authorization": "Bearer {{valid_key_text}}"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "ping",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        }
      },
      "expect": {
        "upstream": {
          "count": {
            "equals": 1
          },
          "token_claims": {
            "/sub": {
              "equals": "{{valid_key_subject}}"
            }
          }
        }
      }
    },
    {
      "name": "A GET request",
      "request": {
        "method": "GET",
        "path": "{{mcp_path}}",
        "headers": {
          "Accept": "text/event-stream",
          "Authorization": "Bearer {{valid_key_text}}"
        }
      },
      "expect": {
        "upstream": {
          "count": {
            "equals": 1
          }
        }
      }
    }
  ]
}

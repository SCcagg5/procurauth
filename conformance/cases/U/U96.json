{
  "id": "U96",
  "title": "A tool that needs a second permission asks it without usage, and asks the action of the tool with usage 1.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.7",
    "5.5a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint",
    "no_budget_action",
    "no_multi_action"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of the tool with two permissions",
      "request": {
        "operation": "mcp_call_multi",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/action/name": {
                "equals": "{{action}}"
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "absent": true
              }
            },
            "count": {
              "regex": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    }
  ]
}

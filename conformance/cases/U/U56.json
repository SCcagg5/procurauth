{
  "id": "U56",
  "title": "The PEP sends the credential of the service for the PDP in the header Authorization: Bearer.",
  "role": "pep",
  "paragraphs": [
    "10.0"
  ],
  "requirement": "MUST",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "Use of an action that lists no budget",
      "request": {
        "operation": "use_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {},
            "headers": {
              "Authorization": {
                "regex": "^Bearer .+$"
              }
            },
            "count": {
              "regex": "^[1-9][0-9]*$"
            }
          },
          {
            "json": {},
            "headers": {
              "Authorization": {
                "not_regex": "^Bearer .+$"
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

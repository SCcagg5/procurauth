{
  "id": "U18",
  "title": "A use of an action that lists a budget sends one question with usage 1. A tools/list, a call that asks for input and a call of a tool with no budget send none.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.4",
    "mcp:3.5",
    "mcp:3.6",
    "6.4"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of a tool whose action lists a budget",
      "skip_if": [
        "no_budget_action"
      ],
      "request": {
        "operation": "mcp_call_budget",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/usage": {
                "equals": {
                  "units": 1
                }
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "A tools/list",
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "tools/list",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        },
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A call that ends with InputRequiredResult",
      "skip_if": [
        "no_input_tool"
      ],
      "request": {
        "operation": "mcp_call_input",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A tools/call of a tool whose action lists no budget",
      "request": {
        "operation": "mcp_call_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

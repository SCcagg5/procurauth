{
  "id": "U117",
  "title": "A call that only asks the client for input runs no action. A reason of 17.1 in the answer does not refuse it. The PEP submits no request.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.5",
    "17.7"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint",
    "no_input_tool"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A call that asks for input",
      "request": {
        "operation": "mcp_call_input",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/resultType": {
            "equals": "input_required"
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

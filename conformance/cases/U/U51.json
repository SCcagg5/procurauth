{
  "id": "U51",
  "title": "The service ignores a claim that it does not know.",
  "role": "pep",
  "paragraphs": [
    "9.4"
  ],
  "requirement": "MUST",
  "given": {
    "tokens": {
      "extra": {
        "subject": "alice",
        "claims": {
          "x_unknown": 1,
          "x_object": {
            "a": [
              1,
              2
            ]
          },
          "email": "alice@example.org"
        }
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A token with extra claims",
      "request": {
        "operation": "use_plain",
        "token": "extra"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/subject/id": {
                "equals": "alice"
              }
            }
          }
        ]
      }
    }
  ]
}

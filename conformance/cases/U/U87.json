{
  "id": "U87",
  "title": "The service builds the chain of the resource of a tools/call from its own data.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.2",
    "4.1"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of a tool whose action lists no budget",
      "request": {
        "operation": "mcp_call_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/resource/type": {
                "equals": "{{resource_type}}"
              },
              "/resource/id": {
                "equals": "{{resource_id}}"
              },
              "/resource/properties/ancestors": {
                "equals": "{{ancestors}}"
              }
            }
          }
        ]
      }
    }
  ]
}

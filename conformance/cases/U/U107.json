{
  "id": "U107",
  "title": "The question has the effect only. The members op and view go only in the submission.",
  "role": "pep",
  "paragraphs": [
    "17.1",
    "17.9"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint",
    "no_approval_tool",
    "no_approval_support"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "respond": {
          "body": {
            "request_id": "apr_conf_1",
            "code": "K7QF",
            "verdict": "pending"
          },
          "status": 201
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The call",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/approval/effect": {
                "present": true
              },
              "/context/approval/op": {
                "absent": true
              },
              "/context/approval/view": {
                "absent": true
              },
              "/context/op": {
                "absent": true
              },
              "/context/view": {
                "absent": true
              },
              "/resource/properties/op": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "json": {
              "/op": {
                "present": true
              },
              "/view": {
                "present": true
              },
              "/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}

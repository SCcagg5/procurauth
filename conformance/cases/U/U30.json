{
  "id": "U30",
  "title": "A call whose use needs an approval asks one question without effect, then one with the effect and no usage, and it waits. After the approval it asks one with usage. A refused approval gets none.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.5a",
    "mcp:5.7",
    "17.1",
    "17.7"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "{{other_action}}",
          "usage": false,
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "effect": "{{effect_3}}"
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_denied"
            }
          }
        }
      },
      {
        "when": {
          "effect": "{{effect_2}}",
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {
          "effect": "{{effect_2}}",
          "usage": false
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "respond": {
          "body": {
            "request_id": "apr_conf_1",
            "code": "K7QF",
            "verdict": "pending"
          },
          "status": 201
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The call, with no approval",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/resultType": {
            "equals": "complete"
          },
          "/result/isError": {
            "absent": true
          },
          "/result/structuredContent/action/status": {
            "equals": "awaiting_approval"
          },
          "/result/structuredContent/action/executed": {
            "equals": false
          },
          "/error": {
            "absent": true
          },
          "/result/content/1/text": {
            "regex": "^NOT EXECUTED"
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/approval/effect": {
                "equals": "{{effect}}"
              },
              "/context/usage": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          },
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/approval": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "The call, with an approval that can be used",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person",
        "variant": "effect_2"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/isError": {
            "absent": true
          },
          "/result/structuredContent/action": {
            "absent": true
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/approval/effect": {
                "equals": "{{effect_2}}"
              },
              "/context/usage": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/approval/effect": {
                "equals": "{{effect_2}}"
              },
              "/context/usage": {
                "equals": {
                  "units": 1
                }
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/approval": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "The call, with a refused approval",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person",
        "variant": "effect_3"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/isError": {
            "equals": true
          },
          "/result/structuredContent/error/code": {
            "equals": "approval_denied"
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

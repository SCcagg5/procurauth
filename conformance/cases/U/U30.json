{
  "id": "U30",
  "title": "A tool whose action waits for an approval sends one question without usage at the call, and one with usage 1 after the approval. A refused approval sends none with usage.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.5a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint",
    "no_budget_action",
    "no_approval_tool"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The call",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/usage": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "The approval and the run",
      "request": {
        "operation": "mcp_approve",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/usage": {
                "equals": {
                  "units": 1
                }
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "The call, one more time",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "The refused approval",
      "request": {
        "operation": "mcp_refuse",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

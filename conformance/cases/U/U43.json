              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "No iss",
      "request": {
        "operation": "use_plain",
        "token": "none"
      },
      "expect": {
        "status": {
          "equals": 401
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]

{
  "id": "U90",
  "title": "A false answer with a reason other than budget_exceeded gives -32602 on tools/call, and the answer shows no reason.",
  "role": "pep",
  "paragraphs": [
    "mcp:5.1",
    "10.3"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "unknown_subject"
            }
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The reason is unknown_subject",
      "request": {
        "operation": "mcp_call_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "body_text": {
          "not_regex": "unknown_subject"
        },
        "json": {
          "/error/code": {
            "equals": -32602
          }
        }
      }
    }
  ]
}

{
  "id": "U27",
  "title": "An MCP request with no identity token gets HTTP 401 and an empty body.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.3",
    "mcp:3.3a",
    "mcp:5.2",
    "mcp:5.6a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {},
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A ping with no token",
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "ping",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 401
        },
        "body_text": {
          "equals": ""
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

{
  "id": "U75",
  "title": "A request to the route with no token, or with a bad token, gets HTTP 401.",
  "role": "pep",
  "paragraphs": [
    "5.7",
    "9.4"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_options_route"
  ],
  "given": {
    "tokens": {
      "bad": {
        "subject": "alice",
        "defect": "bad_signature"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "No token",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}"
      },
      "expect": {
        "status": {
          "equals": 401
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A bad signature",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}",
        "token": "bad"
      },
      "expect": {
        "status": {
          "equals": 401
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

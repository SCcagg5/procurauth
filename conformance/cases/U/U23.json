{
  "id": "U23",
  "title": "A false answer with budget_exceeded gives a tool error on tools/call, and HTTP 429 with Retry-After and the code -31429 on another request.",
  "role": "pep",
  "paragraphs": [
    "mcp:5.1",
    "mcp:5.3",
    "mcp:5.4",
    "10.3"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "budget_exceeded",
              "retry_after": 12
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of a tool whose action lists a budget",
      "skip_if": [
        "no_budget_action"
      ],
      "request": {
        "operation": "mcp_call_budget",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/resultType": {
            "equals": "complete"
          },
          "/result/isError": {
            "equals": true
          },
          "/result/structuredContent/error/code": {
            "equals": "budget_exceeded"
          },
          "/result/structuredContent/error/retryable": {
            "equals": true
          },
          "/result/structuredContent/error/retry_after": {
            "equals": 12
          },
          "/result/structuredContent/error/message": {
            "present": true
          },
          "/result/content/0/type": {
            "equals": "text"
          },
          "/result/content/0/text": {
            "regex": "^\\{\"error\":\\{.*\"retry_after\":12.*\\}\\}$"
          },
          "/error": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "A ping, when the action mcp.session lists a budget",
      "skip_if": [
        "no_budget_session"
      ],
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "ping",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        },
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 429
        },
        "headers": {
          "Retry-After": {
            "equals": "12"
          }
        },
        "json": {
          "/error/code": {
            "equals": -31429
          },
          "/error/message": {
            "equals": "rate_limited"
          },
          "/error/data/retry_after": {
            "equals": 12
          },
          "/id": {
            "equals": 7
          }
        }
      }
    }
  ]
}

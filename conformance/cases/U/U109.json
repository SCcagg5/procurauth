{
  "id": "U109",
  "title": "The PEP sends to the PDP only the lease_s or the approval_ref that the agent gave. It sends no explanation, no allow_custom flag, no allow_ask_back flag and no hint.",
  "role": "pep",
  "paragraphs": [
    "17.4",
    "17.9a",
    "17.12"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "notes": "The base call of the runner gives the control argument lease_s equal to 900. The variant approval_ref gives approval_ref in place of lease_s.",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "{{other_action}}",
          "usage": false,
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "respond": {
          "body": {
            "request_id": "apr_conf_1",
            "code": "K7QF",
            "verdict": "pending"
          },
          "status": 201
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A call with lease_s",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_approvals": [
          {
            "route": "submit",
            "json": {
              "/lease_s": {
                "equals": 900
              },
              "/approval_ref": {
                "absent": true
              },
              "/until": {
                "absent": true
              },
              "/explanation": {
                "absent": true
              },
              "/allow_custom": {
                "absent": true
              },
              "/allow_ask_back": {
                "absent": true
              },
              "/hint": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "A call with approval_ref",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person",
        "variant": "approval_ref"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_approvals": [
          {
            "route": "submit",
            "json": {
              "/approval_ref": {
                "equals": "{{approval_ref}}"
              },
              "/lease_s": {
                "absent": true
              },
              "/until": {
                "absent": true
              },
              "/explanation": {
                "absent": true
              },
              "/allow_custom": {
                "absent": true
              },
              "/allow_ask_back": {
                "absent": true
              },
              "/hint": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}

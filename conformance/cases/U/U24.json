{
  "id": "U24",
  "title": "The PEP sends the question with context.usage as one Access Evaluation, never in a request with items.",
  "role": "pep",
  "paragraphs": [
    "6.11"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_budget_action"
  ],
  "notes": "The test PDP follows 6.11. It answers HTTP 400 to a request that has items and context.usage. The PEP then gives HTTP 503.",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "Use of an action that lists a budget",
      "request": {
        "operation": "use_budget",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}

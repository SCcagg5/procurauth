{
  "id": "U70",
  "title": "The question for a child of the first level has the type of the child, a chain with the service, and context.match equal to subtree.",
  "role": "pep",
  "paragraphs": [
    "5.6",
    "4.1"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_options_route"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "match": "subtree"
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": false
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "List the first level",
      "request": {
        "operation": "list_options",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/resource/type": {
                "equals": "{{options_type}}"
              },
              "/resource/properties/ancestors": {
                "equals": [
                  {
                    "type": "service",
                    "id": "{{service}}"
                  }
                ]
              },
              "/context/match": {
                "equals": "subtree"
              }
            },
            "count": {
              "regex": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    }
  ]
}

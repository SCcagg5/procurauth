{
  "id": "U88",
  "title": "A tools/list asks one question for each action with context.match equal to subtree, without usage, on the resource of type service.",
  "role": "pep",
  "paragraphs": [
    "mcp:4.1"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/list",
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "tools/list",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        },
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_questions": [
          {
            "json": {
              "/context/match": {
                "equals": "subtree"
              },
              "/resource/type": {
                "equals": "service"
              },
              "/resource/id": {
                "equals": "{{service}}"
              }
            },
            "count": {
              "regex": "^[1-9][0-9]*$"
            }
          },
          {
            "json": {
              "/context/match": {
                "not_regex": "^subtree$"
              }
            },
            "count": {
              "equals": 0
            }
          },
          {
            "json": {
              "/resource/type": {
                "not_regex": "^service$"
              }
            },
            "count": {
              "equals": 0
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

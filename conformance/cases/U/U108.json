{
  "id": "U108",
  "title": "The effect is the hash of the service, the action, the resource and the op, as protocol 17.3 gives. The view has only JSON Pointers to values of op.",
  "role": "pep",
  "paragraphs": [
    "17.3",
    "17.9",
    "17.3a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "notes": "The profile of the service gives the op of the base call. The runner computes the variable effect from it. The view of the tool has one field and a body, so that the case can check both pointers.",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "{{other_action}}",
          "usage": false,
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "respond": {
          "body": {
            "request_id": "apr_conf_1",
            "code": "K7QF",
            "verdict": "pending"
          },
          "status": 201
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The call",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "pdp_approvals": [
          {
            "route": "submit",
            "json": {
              "/effect": {
                "equals": "{{effect}}"
              },
              "/view/fields/0/1": {
                "regex": "^(/([^/~]|~[01])*)*$"
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}

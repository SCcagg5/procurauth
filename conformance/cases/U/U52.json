{
  "id": "U52",
  "title": "The service accepts a token signed with ES256 when the key set of the edge holds that key.",
  "role": "pep",
  "paragraphs": [
    "9.4"
  ],
  "requirement": "MUST",
  "notes": "The runner has an ES256 test key. Question 12 in notes/spec-questions-cases.md asks if each service must trust it.",
  "given": {
    "tokens": {
      "es": {
        "subject": "alice",
        "alg": "ES256"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A token signed with ES256",
      "request": {
        "operation": "use_plain",
        "token": "es"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/subject/id": {
                "equals": "alice"
              }
            }
          }
        ]
      }
    }
  ]
}

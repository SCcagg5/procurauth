{
  "id": "U40",
  "title": "The PEP never asks the PDP for the action access.",
  "role": "pep",
  "paragraphs": [
    "8.3"
  ],
  "requirement": "MUST",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "Use of an action that lists no budget",
      "request": {
        "operation": "use_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "access"
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "Use of the service itself",
      "request": {
        "operation": "use_service",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "access"
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

{
  "id": "U100",
  "title": "A call whose use needs an approval runs nothing at the first call. The service submits the request with the effect, op and view, and it gives the result that tells that the action waits.",
  "role": "pep",
  "paragraphs": [
    "5.2b",
    "mcp:5.7",
    "17.4",
    "17.7"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "{{other_action}}",
          "usage": false,
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "respond": {
          "body": {
            "request_id": "apr_conf_1",
            "code": "K7QF",
            "verdict": "pending"
          },
          "status": 201
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The call",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/resultType": {
            "equals": "complete"
          },
          "/result/isError": {
            "absent": true
          },
          "/result/structuredContent/action/status": {
            "equals": "awaiting_approval"
          },
          "/result/structuredContent/action/executed": {
            "equals": false
          },
          "/error": {
            "absent": true
          },
          "/result/structuredContent/action/id": {
            "equals": "apr_conf_1"
          },
          "/result/structuredContent/action/code": {
            "equals": "K7QF"
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              },
              "/context/approval/effect": {
                "equals": "{{effect}}"
              },
              "/context/usage": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "json": {
              "/evaluation_id": {
                "equals": "ev_conformance_1"
              },
              "/effect": {
                "equals": "{{effect}}"
              },
              "/op": {
                "present": true
              },
              "/view": {
                "present": true
              }
            },
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}

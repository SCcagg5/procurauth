{
  "id": "U93",
  "title": "The tool error of a refused budget holds structuredContent as compact JSON in content[0].text.",
  "role": "pep",
  "paragraphs": [
    "mcp:5.3",
    "mcp:5.3a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint",
    "no_budget_action"
  ],
  "notes": "The regular expression lets the members of the error object come in any order.",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "budget_exceeded",
              "retry_after": 12
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of a tool whose action lists a budget",
      "request": {
        "operation": "mcp_call_budget",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/content/0/text": {
            "regex": "^\\{\"error\":\\{.*\"code\":\"budget_exceeded\".*\\}\\}$"
          },
          "/result/structuredContent/error": {
            "present": true
          }
        }
      }
    }
  ]
}

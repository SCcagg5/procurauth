{
  "id": "U78",
  "title": "A request to the route with a limit that is not a whole number from 1 gets HTTP 400.",
  "role": "pep",
  "paragraphs": [
    "5.7"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_options_route"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The limit is 0",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}&limit=0",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 400
        }
      }
    },
    {
      "name": "The limit is -1",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}&limit=-1",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 400
        }
      }
    },
    {
      "name": "The limit is abc",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}&limit=abc",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 400
        }
      }
    },
    {
      "name": "The limit is 1.5",
      "request": {
        "method": "GET",
        "path": "/.well-known/procurauth/resources?type={{options_type}}&limit=1.5",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 400
        }
      }
    }
  ]
}

{
  "id": "U37",
  "title": "A PEP that knows a ceiling of its action accepts a true answer with a value of this ceiling.",
  "role": "pep",
  "paragraphs": [
    "7.3",
    "7.5",
    "10.2"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_ceiling_action"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "usage": true
        },
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "limits": {
                "{{ceiling}}": "{{ceiling_value}}"
              },
              "usage": {
                "units": 1
              }
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true,
            "context": {
              "limits": {
                "{{ceiling}}": "{{ceiling_value}}"
              }
            }
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The PDP gives the ceiling of the action",
      "request": {
        "operation": "use_ceiling",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "{{action}}"
              }
            },
            "count": {
              "regex": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    }
  ]
}

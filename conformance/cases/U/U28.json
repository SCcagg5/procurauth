{
  "id": "U28",
  "title": "When the test PDP does not answer, a tools/call gets HTTP 503 and the code -32603.",
  "role": "pep",
  "paragraphs": [
    "mcp:5.1",
    "mcp:5.5"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {},
        "respond": {
          "no_answer": true
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A tools/call of a tool whose action lists no budget",
      "request": {
        "operation": "mcp_call_plain",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 503
        },
        "json": {
          "/error/code": {
            "equals": -32603
          },
          "/error/message": {
            "present": true
          }
        }
      }
    }
  ]
}

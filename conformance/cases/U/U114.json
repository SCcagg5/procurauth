{
  "id": "U114",
  "title": "A method with no tool cannot wait. When the PDP answers approval_required for mcp.session, the ping gets HTTP 403 and the code -32001. The PEP sends no effect and submits no request.",
  "role": "pep",
  "paragraphs": [
    "mcp:3.6a",
    "mcp:5.1",
    "17.7a"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "mcp.session"
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A ping",
      "request": {
        "method": "POST",
        "path": "{{mcp_path}}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "MCP-Protocol-Version": "2026-07-28",
          "Mcp-Method": "ping"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "ping",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28"
            }
          }
        },
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 403
        },
        "json": {
          "/error/code": {
            "equals": -32001
          },
          "/error/message": {
            "equals": "forbidden"
          },
          "/error/data": {
            "absent": true
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/approval": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "count": {
              "equals": 0
            }
          }
        ]
      }
    }
  ]
}

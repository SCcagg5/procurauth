{
  "id": "D18",
  "title": "A chain whose first object is not the service of the PEP gets false with invalid_resource.",
  "role": "pdp",
  "paragraphs": [
    "4.1",
    "11.1"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json"
  },
  "steps": [
    {
      "name": "The chain starts with a host",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "invalid_resource"
          }
        }
      }
    },
    {
      "name": "The chain starts with another service",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "other"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "invalid_resource"
          }
        }
      }
    },
    {
      "name": "The resource is another service",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "service",
            "id": "other"
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "invalid_resource"
          }
        }
      }
    }
  ]
}

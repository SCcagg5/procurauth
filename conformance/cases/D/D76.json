{
  "id": "D76",
  "title": "A grant with confirm makes the PDP answer false with approval_required and an evaluation_id, and no unit, until an approval can be used.",
  "role": "pdp",
  "paragraphs": [
    "5.2b",
    "11.1",
    "17.1",
    "17.8"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_approval_support"
  ],
  "given": {
    "directory": "approvals.json"
  },
  "steps": [
    {
      "name": "A question with an effect, without usage",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "approval": {
              "effect": "sha256:2e7b47b1726241459949b2d1f67bb47f20f15b0c4995a6e486ebd4ae964a5aab"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    },
    {
      "name": "A question with an effect, with usage",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            },
            "approval": {
              "effect": "sha256:2e7b47b1726241459949b2d1f67bb47f20f15b0c4995a6e486ebd4ae964a5aab"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    },
    {
      "name": "A question with no effect",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "absent": true
          }
        }
      }
    }
  ]
}

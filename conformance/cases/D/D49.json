{
  "id": "D49",
  "title": "A refusal for a budget takes no unit from any counter: the PDP takes the units from all counters of the use, or from none.",
  "role": "pdp",
  "paragraphs": [
    "6.5",
    "6.2",
    "5.5"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "budgets.json"
  },
  "steps": [
    {
      "name": "The write budget is full, and the request budget has one unit left",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "atom"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "budget_exceeded"
          },
          "/context/retry_after": {
            "equals": 12
          },
          "/context/limits": {
            "absent": true
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "A read still has its unit",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "atom"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/usage/units": {
            "equals": 1
          }
        }
      }
    },
    {
      "name": "The next read has no unit",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "atom"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "budget_exceeded"
          },
          "/context/retry_after": {
            "equals": 12
          },
          "/context/limits": {
            "absent": true
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    }
  ]
}

{
  "id": "D65",
  "title": "A value that only one grant gives stays as it is: each grant gives a different ceiling.",
  "role": "pdp",
  "paragraphs": [
    "8.2",
    "7.3"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "ceilings.json"
  },
  "steps": [
    {
      "name": "The database test2: the host grant gives rows, the database grant gives the duration",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "part"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test2",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_rows": {
            "equals": 700
          },
          "/context/limits/max_duration": {
            "equals": 15
          }
        }
      }
    },
    {
      "name": "The database test1: a grant with no value and a grant with a value",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "plain"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_rows": {
            "equals": 30
          },
          "/context/limits/max_duration": {
            "absent": true
          }
        }
      }
    }
  ]
}

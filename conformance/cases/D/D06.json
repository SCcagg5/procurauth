{
  "id": "D06",
  "title": "A spent budget gives a false answer with budget_exceeded and retry_after, and a question without usage counts nothing.",
  "role": "pdp",
  "paragraphs": [
    "6.5",
    "6.6",
    "11.1"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json",
    "clock": {
      "now": 1792569648
    },
    "counters": [
      {
        "subject": "alice",
        "limit": "requests",
        "window": "minute",
        "used": 300
      }
    ]
  },
  "steps": [
    {
      "name": "Alice has used 300 of 300 units in the minute, and 12 seconds remain",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "budget_exceeded"
          },
          "/context/retry_after": {
            "equals": 12
          },
          "/context/limits": {
            "absent": true
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "The same question without usage counts nothing",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    }
  ]
}

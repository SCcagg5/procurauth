        }
      }
    },
    {
      "name": "The database has an id with a control character",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "cora"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "a\u0007b",

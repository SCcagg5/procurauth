{
  "id": "D23",
  "title": "A node id that is empty, longer than 256 bytes or holds a control character gives false.",
  "role": "pdp",
  "paragraphs": [
    "4.1"
  ],
  "requirement": "MUST",
  "notes": "Question 1 in notes/spec-questions-cases.md asks which reason the answer has. The case does not check it.",
  "given": {
    "directory": "tree.json"
  },
  "steps": [
    {
      "name": "The database has an empty id",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "cora"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          }
        }
      }
    },
    {
      "name": "The database has an id of 257 bytes",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "cora"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false

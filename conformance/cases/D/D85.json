{
  "id": "D85",
  "title": "After a refusal, a question for the same effect gets approval_denied during the deny time. Another effect, and a question after the deny time, get approval_required.",
  "role": "pdp",
  "paragraphs": [
    "17.1",
    "17.6"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_approval_support"
  ],
  "given": {
    "directory": "approvals.json"
  },
  "steps": [
    {
      "name": "The same effect, without usage",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "approval": {
              "effect": "sha256:586f0b594db38e23e546729534ee726be628a8bc8ddddd934ecb006fc10cf8a0"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_denied"
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "The same effect, with usage",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            },
            "approval": {
              "effect": "sha256:586f0b594db38e23e546729534ee726be628a8bc8ddddd934ecb006fc10cf8a0"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_denied"
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    },
    {
      "name": "Another effect",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "approval": {
              "effect": "sha256:5f6036abd194fa3d58de98f03dfe87e4b0f646fbd9c787e44592b5123090023f"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    },
    {
      "name": "The same effect as a refusal whose deny time has ended",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "approval": {
              "effect": "sha256:4263007ae516a240ed3b4ec63e6586e1a91c5b384cdc4838eeec932918843bbc"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    }
  ]
}

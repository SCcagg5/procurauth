{
  "id": "D52",
  "title": "A subject with no budget gets true with units 0 for each use, and the PDP never refuses it for a budget.",
  "role": "pdp",
  "paragraphs": [
    "6.12",
    "6.10"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "budgets.json"
  },
  "steps": [
    {
      "name": "Use number 1",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "nolimit"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/usage/units": {
            "equals": 0
          }
        }
      }
    },

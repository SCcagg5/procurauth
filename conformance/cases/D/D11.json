{
  "id": "D11",
  "title": "A revoked key and an expired key are unknown subjects, and the owner keeps its own rights.",
  "role": "pdp",
  "paragraphs": [
    "3.8",
    "11.1"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "keys.json"
  },
  "steps": [
    {
      "name": "The active key",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:ada-active"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          }
        }
      }
    },
    {
      "name": "The revoked key",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:ada-revoked"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "unknown_subject"
          }
        }
      }
    },
    {
      "name": "The expired key",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:ada-expired"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "unknown_subject"
          }
        }
      }
    },
    {
      "name": "The owner",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "ada"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          }
        }
      }
    }
  ]
}

{
  "id": "D45",
  "title": "When the counters of two windows are full, retry_after is the latest end of the two.",
  "role": "pdp",
  "paragraphs": [
    "11.1",
    "6.7"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "budgets.json",
    "counters": [
      {
        "subject": "quad",
        "limit": "requests",
        "window": "second",
        "used": 1
      },
      {
        "subject": "quad",
        "limit": "requests",
        "window": "minute",
        "used": 1
      }
    ]
  },
  "steps": [
    {
      "name": "The counters of the second and of the minute are full",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "quad"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "budget_exceeded"
          },
          "/context/retry_after": {
            "equals": 12
          },
          "/context/limits": {
            "absent": true
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    }
  ]
}

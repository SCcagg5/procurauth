{
  "id": "D13",
  "title": "A person that the directory does not hold is an unknown subject.",
  "role": "pdp",
  "paragraphs": [
    "11.1"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json"
  },
  "steps": [
    {
      "name": "A deleted person",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "zoe"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "database",
            "id": "test1",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "unknown_subject"
          }
        }
      }
    }
  ]
}

{
  "id": "D79",
  "title": "An approval applies only to the same subject, the same resource and the same effect. Another subject, resource or effect gets approval_required.",
  "role": "pdp",
  "paragraphs": [
    "17.1"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_approval_support"
  ],
  "notes": "The last step shows that the first three differ only in one value of the approval.",
  "given": {
    "directory": "approvals.json"
  },
  "steps": [
    {
      "name": "Another subject",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0002"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            },
            "approval": {
              "effect": "sha256:010506ea769c671006d5605a843a79036cb8655d741732daf641b0195afd90c4"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    },
    {

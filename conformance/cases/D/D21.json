            "equals": true
          }
        }
      }
    },
    {
      "name": "A column below a column",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "colm"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "column",
            "id": "x",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                },
                {
                  "type": "database",
                  "id": "main"
                },
                {
                  "type": "table",
                  "id": "users"
                },
                {
                  "type": "column",
                  "id": "email"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200

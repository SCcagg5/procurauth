  "paragraphs": [
    "4.1",
    "11.1"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "tree.json"
  },
  "steps": [
    {
      "name": "A column, at depth 4",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "colm"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "column",
            "id": "email",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                },
                {
                  "type": "database",
                  "id": "main"
                },
                {
                  "type": "table",
                  "id": "users"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {

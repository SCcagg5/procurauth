{
  "id": "D82",
  "title": "A grant with confirm on the side of the owner makes a key need an approval. The grant of the key can have no confirm.",
  "role": "pdp",
  "paragraphs": [
    "17.8"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_approval_support"
  ],
  "given": {
    "directory": "approvals.json"
  },
  "steps": [
    {
      "name": "A question for a key of Carol",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:ownconf01"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "database",
            "id": "analytics",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                }
              ]
            }
          },
          "context": {
            "usage": {
              "units": 1
            },
            "approval": {
              "effect": "sha256:f0f43c48e195546e4b7c5be66be750e2f2b7f33ca59f5b5ab568cf30d9ee72f8"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "approval_required"
          },
          "/context/usage": {
            "absent": true
          },
          "/context/evaluation_id": {
            "present": true
          }
        }
      }
    }
  ]
}

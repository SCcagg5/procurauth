{
  "id": "D83",
  "title": "A question with context.match subtree gets true for an action that has a grant with confirm. It does not ask for an approval.",
  "role": "pdp",
  "paragraphs": [
    "4.4",
    "17.1",
    "17.8"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_approval_support"
  ],
  "given": {
    "directory": "approvals.json"
  },
  "steps": [
    {
      "name": "A subtree question on the service",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "service",
            "id": "datastore"
          },
          "context": {
            "match": "subtree"
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          }
        }
      }
    },
    {
      "name": "A subtree question with an effect",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "key:conf0001"
          },
          "action": {
            "name": "data.write"
          },
          "resource": {
            "type": "service",
            "id": "datastore"
          },
          "context": {
            "match": "subtree",
            "approval": {
              "effect": "sha256:55af60860dde5c4f90645fac78df995ae6553b4d9397db277840f76f165251e5"
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          }
        }
      }
    }
  ]
}

{
  "id": "D01",
  "title": "A grant covers the node and each node below it, also a node that the service adds later.",
  "role": "pdp",
  "paragraphs": [
    "4.3",
    "7.3"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json"
  },
  "steps": [
    {
      "name": "Alice reads a table of test1 that the directory does not list",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "alice"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "table",
            "id": "ledger",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                },
                {
                  "type": "host",
                  "id": "prod"
                },
                {
                  "type": "database",
                  "id": "test1"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          },
          "/context/limits/max_rows": {
            "equals": 1000
          },
          "/context/usage": {
            "absent": true
          }
        }
      }
    }
  ]
}

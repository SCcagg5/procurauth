{
  "id": "D75",
  "title": "A resource of depth 1 with no chain, or with an empty chain, gets false with invalid_resource. Its correct chain holds only the service.",
  "role": "pdp",
  "paragraphs": [
    "4.1",
    "11.1"
  ],
  "requirement": "MUST",
  "notes": "Hana holds a grant of data.read on service:datastore/host:prod. A PDP that reads a node with no chain as a node of depth 1 answers true in the first step.",
  "given": {
    "directory": "tree.json"
  },
  "steps": [
    {
      "name": "No properties",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "hana"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "host",
            "id": "prod"
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "invalid_resource"
          }
        }
      }
    },
    {
      "name": "An empty array",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "hana"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "host",
            "id": "prod",
            "properties": {
              "ancestors": []
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": false
          },
          "/context/reason": {
            "equals": "invalid_resource"
          }
        }
      }
    },
    {
      "name": "The chain with only the service",
      "request": {
        "endpoint": "evaluation",
        "body": {
          "subject": {
            "type": "user",
            "id": "hana"
          },
          "action": {
            "name": "data.read"
          },
          "resource": {
            "type": "host",
            "id": "prod",
            "properties": {
              "ancestors": [
                {
                  "type": "service",
                  "id": "datastore"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/decision": {
            "equals": true
          }
        }
      }
    }
  ]
}

{
  "id": "D58",
  "title": "A context.usage that is not an object with the member units equal to 1 gets HTTP 400.",
  "role": "pdp",
  "paragraphs": [
    "6.4"
  ],
  "requirement": "MUST",
  "given": {
    "directory": "datastore.json"
  },
  "steps": [

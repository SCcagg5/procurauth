{
  "grants": [
    {
      "action": "access",
      "resource": "service:datastore",
      "limits": {
        "requests": [
          {
            "amount": 10,
            "window": "second"
          },
          {
            "amount": 300,
            "window": "minute"
          }
        ]
      }
    },
    {
      "action": "data.read",
      "resource": "service:datastore/host:prod/database:test1",
      "limits": {
        "requests": [
          {
            "amount": 1,
            "window": "second"
          }
        ]
      }
    },
    {
      "action": "data.write",
      "resource": "service:datastore/host:prod/database:test2"
    }
  ]
}
